{
  "name": "pulseops",
  "private": true,
  "workspaces": [
    "packages/*",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:worker": "npm run worker --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "migrate": "npm run migrate --workspace=server",
    "build": "npm run build --workspace=packages/shared-types && npm run build --workspace=server && npm run build --workspace=client"
  }
}
