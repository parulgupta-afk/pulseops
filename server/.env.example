PORT=4000
DATABASE_URL=your_database_url_here
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=http://localhost:5173

# Not used until later phases, but listed here so .env is set up once.
REDIS_URL=redis://localhost:6379
# Phase 4: MockNotificationProvider is always used (no real Twilio/SendGrid
# wiring yet — see server/src/notifications/). Set to true to make it fail
# ~35% of the time on purpose, so you can actually watch the queue's
# retry-with-backoff kick in during a demo instead of it always succeeding.
NOTIFICATION_SIMULATE_FAILURES=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Phase 5: RAG-based incident triage. Free key, no billing/phone verification
# required: https://aistudio.google.com/apikey
# Leave blank to use the built-in mock embedding/generation providers instead
# (see server/src/ai/) — the whole pipeline still works without a key, just
# without real semantic understanding.
GEMINI_API_KEY=your_gemini_api_key_here
