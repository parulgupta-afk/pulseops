PORT=4000
DATABASE_URL=postgres://pulseops:pulseops@localhost:5432/pulseops
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# Phase 6: observability. LOG_LEVEL controls pino's verbosity (trace/debug/info/
# warn/error). NODE_ENV=production switches pino to raw JSON output instead of
# pretty-printing, and OTEL_SERVICE_NAME labels this process's spans if you're
# running server and worker side by side in a real trace backend.
LOG_LEVEL=info
OTEL_SERVICE_NAME=pulseops-api

# Not used until later phases, but listed here so .env is set up once.
REDIS_URL=redis://localhost:6379
# Phase 4: MockNotificationProvider is always used (no real Twilio/SendGrid
# wiring yet — see server/src/notifications/). Set to true to make it fail
# ~35% of the time on purpose, so you can actually watch the queue's
# retry-with-backoff kick in during a demo instead of it always succeeding.
NOTIFICATION_SIMULATE_FAILURES=false
# Phase 4 notifications, real providers. The spec originally called for
# Twilio (SMS) + SendGrid (email), but both have gotten unreliable to sign up
# for quickly (Twilio's trial number issuance is inconsistent; SendGrid's
# account approval can stall) — swapped for Resend (email) and Textbelt (SMS),
# which are genuinely low-friction. Leave either blank/disabled and that
# channel automatically falls back to MockNotificationProvider — see
# server/src/notifications/index.ts.

# Email via Resend — free tier, no domain verification needed to start.
# Get a key at https://resend.com/api-keys (just email + password to sign up).
# Without a verified domain you can only send FROM onboarding@resend.dev and
# TO the email address you signed up with.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# SMS via Textbelt — no signup at all. The shared "textbelt" key sends 1 real
# free SMS/day; set your own TEXTBELT_KEY if you buy credit for more.
# Deliberately requires this explicit flag (not just a key) before sending
# anything real, since Textbelt's shared key needs no configuration at all —
# without this flag it'd be too easy to accidentally send a real text.
TEXTBELT_ENABLED=false
TEXTBELT_KEY=
# Phase 5: RAG-based incident triage. Free key, no billing/phone verification
# required: https://aistudio.google.com/apikey
# Leave blank to use the built-in mock embedding/generation providers instead
# (see server/src/ai/) — the whole pipeline still works without a key, just
# without real semantic understanding.
GEMINI_API_KEY=
